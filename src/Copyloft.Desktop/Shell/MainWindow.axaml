<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Copyloft.Desktop.Localization"
        xmlns:controls="using:Copyloft.Desktop.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Copyloft.Desktop.Shell.MainWindow"
        Title="{l:Tr Key=App_Name}"
        Icon="/Assets/app.ico"
        Width="940" Height="660" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly">
  <Window.Styles>
    <!-- Rail item: icon only, a hover wash, the accent tint when selected. -->
    <Style Selector="RadioButton.rail">
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.rail:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    <Style Selector="RadioButton.rail:checked">
      <Setter Property="Background" Value="{DynamicResource CopyloftAccentSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
    </Style>
    <!-- Caption buttons: flat, the hover wash, close turns red like Windows. -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption Path">
      <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CopyloftCaptionCloseBrush}" />
    </Style>
    <Style Selector="Button.caption.close:pointerover Path">
      <Setter Property="Stroke" Value="{DynamicResource SystemControlForegroundChromeWhiteBrush}" />
    </Style>
    <Style Selector="RadioButton.rail PathIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
  </Window.Styles>

  <!-- Main's shell: the content runs into the title bar, which carries the app name, the Settings
       search and our own caption buttons. Avalonia's drawn caption doubled the title and added a
       fullscreen button, so only the border is left to the platform (DESIGN.md, Window chrome). -->
  <Grid RowDefinitions="48,*" ColumnDefinitions="48,*">
    <Grid x:Name="TitleBar" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" Background="Transparent"
          chrome:WindowDecorationProperties.ElementRole="TitleBar">
      <StackPanel x:Name="AppTitle" Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
        <!-- app.ico decodes at its largest frame; an unfiltered downscale to 16 px looked pixelated. -->
        <Image x:Name="TitleIcon" Source="/Assets/app.ico" Width="16" Height="16" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="{l:Tr Key=App_Name}" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <!-- Spans the bar so it centers on the window; the side margins keep it off the title and the
           caption buttons, and a narrow window shrinks it. -->
      <TextBox x:Name="SearchBox" Grid.ColumnSpan="3" Margin="160,0"
               MaxWidth="360" Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center"
               chrome:WindowDecorationProperties.ElementRole="User"
               PlaceholderText="{l:Tr Key=Settings_SearchPlaceholder}"
               AutomationProperties.Name="{l:Tr Key=Settings_SearchPlaceholder}"
               IsVisible="False" />
      <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="MinimizeButton" Classes="caption"
                chrome:WindowDecorationProperties.ElementRole="MinimizeButton"
                AutomationProperties.Name="{l:Tr Key=Window_Minimize}">
          <Path Data="M0,0.5 H10" />
        </Button>
        <Button x:Name="MaximizeButton" Classes="caption"
                chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                AutomationProperties.Name="{l:Tr Key=Window_Maximize}">
          <Panel>
            <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" />
            <Path x:Name="RestoreGlyph" Data="M2.5,0.5 H9.5 V7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z" IsVisible="False" />
          </Panel>
        </Button>
        <Button x:Name="CloseButton" Classes="caption close"
                chrome:WindowDecorationProperties.ElementRole="CloseButton"
                AutomationProperties.Name="{l:Tr Key=Window_Close}">
          <Path Data="M0,0 L10,10 M10,0 L0,10" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Compact rail: History on top, Settings in the footer. -->
    <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" Margin="4,0,4,8">
      <RadioButton x:Name="HistoryButton"
                   Classes="rail" GroupName="Nav"
                   ToolTip.Tip="{l:Tr Key=Nav_History}"
                   AutomationProperties.Name="{l:Tr Key=Nav_History}">
        <controls:AppIcon Kind="Document" />
      </RadioButton>
      <RadioButton x:Name="SettingsButton"
                   Grid.Row="2"
                   Classes="rail" GroupName="Nav"
                   ToolTip.Tip="{l:Tr Key=Nav_Settings}"
                   AutomationProperties.Name="{l:Tr Key=Nav_Settings}">
        <controls:AppIcon Kind="Settings" />
      </RadioButton>
    </Grid>

    <!-- The section sits on a layer with a rounded leading corner, as in main. -->
    <Border x:Name="ContentLayer" Grid.Row="1" Grid.Column="1"
            CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
            Background="{DynamicResource CopyloftLayerBrush}"
            BorderBrush="{DynamicResource SystemControlTransientBorderBrush}">
      <ContentControl x:Name="Section" Margin="24,16,24,16" />
    </Border>
  </Grid>
</Window>
