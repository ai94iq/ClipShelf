<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The exe keeps its old name so existing autostart entries and installs still find it. -->
    <AssemblyName>Copyloft</AssemblyName>
    <AssemblyTitle>Copyloft</AssemblyTitle>
    <RootNamespace>Copyloft.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>ar</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- AVLN3001: windows take services in their constructors and are built by DI, never by the
         runtime XAML loader, so a parameterless constructor would only invite misuse. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Copyloft.Desktop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Copyloft.Core\Copyloft.Core.csproj" />
    <ProjectReference Include="..\Copyloft.Data\Copyloft.Data.csproj" />
    <ProjectReference Include="..\Copyloft.Presentation\Copyloft.Presentation.csproj" />
  </ItemGroup>
</Project>
