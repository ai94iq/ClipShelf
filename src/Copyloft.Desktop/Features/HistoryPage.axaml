<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Copyloft.Desktop.Localization"
             xmlns:controls="using:Copyloft.Desktop.Controls"
             xmlns:vm="using:Copyloft.Presentation.Features.ClipboardPanel"
             x:Class="Copyloft.Desktop.Features.HistoryPage"
             x:DataType="vm:ClipboardPanelViewModel">
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- Rows answer the pointer with the list wash; the keyboard row wears the accent tint. -->
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CopyloftAccentSubtleBrush}" />
    </Style>
    <Style Selector="ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The page actions are bare glyphs beside the search, as in the flyout: no fill at rest or
         disabled (Fluent's disabled fill drew a gray block), the list wash on hover, faded while
         they cannot act. -->
    <Style Selector="Button.glyph">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.glyph:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.glyph:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.glyph:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    <Style Selector="Button.glyph PathIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="6">
      <TextBlock Text="{l:Tr Key=History_Title}" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="{l:Tr Key=History_Description}"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
    </StackPanel>

    <!-- Search and the category filter -->
    <!-- Search, the category filter and the page actions -->
    <Grid Grid.Row="1" Margin="0,12,0,6" ColumnDefinitions="*,Auto,Auto">
      <TextBox x:Name="SearchBox" Height="36" VerticalContentAlignment="Center"
               IsEnabled="{Binding CanSearch}"
               PlaceholderText="{l:Tr Key=Panel_SearchPlaceholder}"
               AutomationProperties.Name="{l:Tr Key=Panel_SearchPlaceholder}"
               Text="{Binding SearchText}" />
      <ComboBox x:Name="CategoryFilter" Grid.Column="1" Margin="8,0,0,0"
                MinWidth="180" MinHeight="36"
                AutomationProperties.Name="{l:Tr Key=History_Filter}"
                ItemsSource="{Binding CategoryFilterOptions}"
                SelectedItem="{Binding SelectedCategoryFilter}"
                DisplayMemberBinding="{ReflectionBinding Label}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
        <Button x:Name="SelectButton" Classes="glyph"
                ToolTip.Tip="{l:Tr Key=Selection_Select}" AutomationProperties.Name="{l:Tr Key=Selection_Select}"
                Command="{Binding ToggleSelectionCommand}"
                IsEnabled="{Binding HasItems}" IsVisible="{Binding ShowSelectButton}">
          <controls:AppIcon Kind="Checkmark" />
        </Button>
        <Button x:Name="CopySelectedButton" Classes="glyph"
                ToolTip.Tip="{l:Tr Key=Selection_Copy}" AutomationProperties.Name="{l:Tr Key=Selection_Copy}"
                Command="{Binding CopySelectedCommand}"
                IsEnabled="{Binding CanCopySelection}" IsVisible="{Binding IsSelecting}">
          <controls:AppIcon Kind="Copy" />
        </Button>
        <Button x:Name="CancelSelectButton" Classes="glyph"
                ToolTip.Tip="{l:Tr Key=Common_Cancel}" AutomationProperties.Name="{l:Tr Key=Common_Cancel}"
                Command="{Binding ToggleSelectionCommand}" IsVisible="{Binding IsSelecting}">
          <controls:AppIcon Kind="Dismiss" />
        </Button>
        <Button x:Name="ClearAllButton" Classes="glyph"
                ToolTip.Tip="{l:Tr Key=Panel_ClearAll}" AutomationProperties.Name="{l:Tr Key=Panel_ClearAll}"
                Command="{Binding RequestClearCommand}"
                IsEnabled="{Binding HasItems}" IsVisible="{Binding ShowSelectButton}">
          <controls:AppIcon Kind="Delete" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Grouped history (Pinned, then Recent) on a card, with its load states -->
    <Border Grid.Row="2" Margin="0,4,0,8" Padding="8,8,8,4" CornerRadius="8"
            Background="{DynamicResource CopyloftCardBrush}"
            BorderBrush="{DynamicResource SystemControlTransientBorderBrush}" BorderThickness="1"
            BoxShadow="{DynamicResource CopyloftCardShadow}"
            IsVisible="{Binding HasItems}">
      <!-- The end padding keeps the overlay scroll bar off the row actions. -->
      <ListBox x:Name="ClipList" Background="Transparent" SelectionMode="Single" Padding="0,0,12,0">
        <ListBox.DataTemplates>
          <DataTemplate x:DataType="vm:ClipGroup">
            <!-- Main's group header: the title ruled off from its rows. -->
            <StackPanel Margin="0,8,0,2" Spacing="8">
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                         Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
              <Border Classes="rule" Height="1"
                      Background="{DynamicResource SystemControlTransientBorderBrush}" />
            </StackPanel>
          </DataTemplate>
          <DataTemplate x:DataType="vm:ClipItemViewModel">
            <controls:ClipRow />
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </Border>

    <ProgressBar Grid.Row="2" IsIndeterminate="True" VerticalAlignment="Top"
                 IsVisible="{Binding State, Converter={x:Static controls:LoadStateIs.Instance}, ConverterParameter=Loading}" />
    <StackPanel Grid.Row="2" Spacing="12" MaxWidth="280"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding State, Converter={x:Static controls:LoadStateIs.Instance}, ConverterParameter=Empty}">
      <controls:AppIcon Kind="Clipboard" Width="32" Height="32" HorizontalAlignment="Center" Opacity="0.7"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <StackPanel Spacing="4">
        <TextBlock Text="{Binding EmptyTitle}" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
        <TextBlock Text="{Binding EmptyHint}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
      </StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding State, Converter={x:Static controls:LoadStateIs.Instance}, ConverterParameter=Error}">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                 Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}" />
      <Button HorizontalAlignment="Center" Content="{l:Tr Key=Common_Retry}" Command="{Binding ReloadCommand}" />
    </StackPanel>

    <!-- Deferred delete -->
    <Border Grid.Row="2" Margin="0,0,0,16" Padding="12,6" CornerRadius="4" VerticalAlignment="Bottom"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            BoxShadow="{DynamicResource CopyloftCardShadow}"
            IsVisible="{Binding HasPendingDelete}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding PendingDeleteText}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{l:Tr Key=Common_Undo}" Height="28" Padding="12,4" FontSize="13"
                Command="{Binding UndoDeleteCommand}" />
      </Grid>
    </Border>

    <!-- Footer: the true total or the copy notice -->
    <Border x:Name="Footer" Grid.Row="3" BorderThickness="0,1,0,0" Padding="0,8,0,0"
            BorderBrush="{DynamicResource SystemControlTransientBorderBrush}">
      <Grid>
        <TextBlock x:Name="FooterText" Text="{Binding FooterText}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                   IsVisible="{Binding ShowFooterText}" />
        <TextBlock x:Name="CopyNotice" Text="{Binding CopyNotice}" VerticalAlignment="Center"
                   Foreground="{DynamicResource SystemControlForegroundAccentBrush}"
                   IsVisible="{Binding IsShowingCopyNotice}" />
      </Grid>
    </Border>

    <!-- Clear confirm over the page; Esc cancels -->
    <Panel Grid.RowSpan="4" IsVisible="{Binding IsConfirmingClear}">
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Opacity="0.6" />
      <Border Width="300" Padding="16" CornerRadius="8"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
              BorderBrush="{DynamicResource SystemControlTransientBorderBrush}" BorderThickness="1"
              BoxShadow="{DynamicResource CopyloftCardShadow}">
        <StackPanel Spacing="16">
          <TextBlock Text="{l:Tr Key=Panel_ClearConfirm}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="accent" Content="{l:Tr Key=Panel_ClearYes}" Command="{Binding ConfirmClearCommand}" />
            <Button Content="{l:Tr Key=Common_Cancel}" Command="{Binding CancelClearCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
