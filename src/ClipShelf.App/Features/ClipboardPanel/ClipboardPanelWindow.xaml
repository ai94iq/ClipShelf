<Window x:Class="ClipShelf.App.Features.ClipboardPanel.ClipboardPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.App.Localization"
        xmlns:common="using:ClipShelf.App.Common">
  <Grid x:Name="Root" KeyDown="OnKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search: just the field, no background or icon -->
    <Grid Grid.Row="0" Margin="12,10,12,4">
      <TextBox x:Name="SearchBox"
               Height="34"
               Padding="0,0,8,0"
               IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}"
               PlaceholderText="{l:Tr Key=Panel_SearchPlaceholder}"
               Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <TextBox.Resources>
          <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
          <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
          <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        </TextBox.Resources>
      </TextBox>
    </Grid>

    <!-- History with its loading/empty/error overlay -->
    <Grid Grid.Row="1">
      <ListView x:Name="ClipList"
                Padding="0"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                ItemTemplate="{StaticResource ClipItemTemplate}"
                SelectionMode="Single"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick">
        <ListView.Resources>
          <!-- Hover stays quiet; the keyboard selection is a soft accent wash. -->
          <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelected"
                           Color="{ThemeResource SystemAccentColor}"
                           Opacity="0.16" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver"
                           Color="{ThemeResource SystemAccentColor}"
                           Opacity="0.20" />
          <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed"
                           Color="{ThemeResource SystemAccentColor}"
                           Opacity="0.24" />
        </ListView.Resources>
        <ListView.ItemContainerTransitions>
          <TransitionCollection />
        </ListView.ItemContainerTransitions>
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
          </Style>
        </ListView.ItemContainerStyle>
      </ListView>

      <common:LoadStateOverlay State="{x:Bind ViewModel.State, Mode=OneWay}"
                               ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               EmptyText="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                               EmptyHint="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                               RetryCommand="{x:Bind ViewModel.ReloadCommand, Mode=OneWay}" />

      <!-- Deferred delete: the row is gone, the delete is not, until the window closes -->
      <Border Style="{StaticResource UndoBarBorder}"
              Margin="12,0,12,8"
              VerticalAlignment="Bottom"
              Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.HasPendingDelete), Mode=OneWay}">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="{x:Bind ViewModel.PendingDeleteText, Mode=OneWay}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="{l:Tr Key=Common_Undo}"
                  MinWidth="0"
                  Height="28"
                  Padding="12,4"
                  FontSize="13"
                  Command="{x:Bind ViewModel.UndoDeleteCommand}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Footer: icon-only actions with tooltips -->
    <Border Grid.Row="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <Grid Padding="12,4" ColumnSpacing="6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0"
                Background="Transparent"
                BorderThickness="0"
                Width="32"
                Height="28"
                Padding="0"
                HorizontalAlignment="Left"
                ToolTipService.ToolTip="{l:Tr Key=Panel_OpenFullHistory}"
                AutomationProperties.Name="{l:Tr Key=Panel_OpenFullHistory}"
                Command="{x:Bind ViewModel.OpenHistoryCommand}">
          <common:AppIcon Kind="Clipboard" Width="16" Height="16" />
        </Button>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Button Background="Transparent"
                  BorderThickness="0"
                  Width="32"
                  Height="28"
                  Padding="0"
                  ToolTipService.ToolTip="{l:Tr Key=Selection_Select}"
                  AutomationProperties.Name="{l:Tr Key=Selection_Select}"
                  Command="{x:Bind ViewModel.ToggleSelectionCommand}"
                  Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.ShowSelectButton), Mode=OneWay}">
            <common:AppIcon Kind="Checkmark" Width="16" Height="16" />
          </Button>

          <Button Background="Transparent"
                  BorderThickness="0"
                  Width="32"
                  Height="28"
                  Padding="0"
                  ToolTipService.ToolTip="{l:Tr Key=Common_Cancel}"
                  AutomationProperties.Name="{l:Tr Key=Common_Cancel}"
                  Command="{x:Bind ViewModel.ToggleSelectionCommand}"
                  Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.IsSelecting), Mode=OneWay}">
            <common:AppIcon Kind="Dismiss" Width="16" Height="16" />
          </Button>

          <Button Background="Transparent"
                  BorderThickness="0"
                  Width="32"
                  Height="28"
                  Padding="0"
                  IsEnabled="{x:Bind ViewModel.CanCopySelection, Mode=OneWay}"
                  ToolTipService.ToolTip="{l:Tr Key=Selection_Copy}"
                  AutomationProperties.Name="{l:Tr Key=Selection_Copy}"
                  Command="{x:Bind ViewModel.CopySelectedCommand}"
                  Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.IsSelecting), Mode=OneWay}">
            <common:AppIcon Kind="Copy" Width="16" Height="16" />
          </Button>

          <Button x:Name="ClearAllButton"
                  Background="Transparent"
                  BorderThickness="0"
                  Width="32"
                  Height="28"
                  Padding="0"
                  IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                  ToolTipService.ToolTip="{l:Tr Key=Panel_ClearAll}"
                  AutomationProperties.Name="{l:Tr Key=Panel_ClearAll}"
                  Command="{x:Bind ViewModel.RequestClearCommand}"
                  Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.ShowSelectButton), Mode=OneWay}">
            <common:AppIcon Kind="Delete" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- In-window confirmation panel (over the content, Esc cancels) -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.IsConfirmingClear), Mode=OneWay}">
      <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.7" />
      <Border Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource CardRadius}"
              Padding="16"
              Width="260"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{l:Tr Key=Panel_ClearConfirm}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ConfirmClearButton"
                    Content="{l:Tr Key=Panel_ClearYes}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.ConfirmClearCommand}" />
            <Button Content="{l:Tr Key=Common_Cancel}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.CancelClearCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
