<Window x:Class="ClipShelf.App.Features.ClipboardPanel.ClipboardPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.App.Localization"
        xmlns:common="using:ClipShelf.App.Common"
        xmlns:features="using:ClipShelf.App.Features.ClipboardPanel">
  <Grid x:Name="Root"
        KeyDown="OnKeyDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search -->
    <Grid Grid.Row="0" Margin="8,8,8,4">
      <TextBox x:Name="SearchBox"
               PlaceholderText="{l:Tr Key=Panel_SearchPlaceholder}"
               Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Padding="32,0,8,0" />
      <common:AppIcon Kind="Search"
                      Width="16"
                      Height="16"
                      Margin="10,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>

    <!-- History and its loading/empty/error overlay -->
    <Grid Grid.Row="1">
      <ListView x:Name="ItemList"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,4" />
          </Style>
        </ListView.ItemContainerStyle>
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="features:ClipItemViewModel">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Preview}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock Text="{x:Bind SourceText}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Command="{x:Bind TogglePinCommand}"
                        ToolTipService.ToolTip="{l:Tr Key=Panel_PinToggle}"
                        AutomationProperties.Name="{l:Tr Key=Panel_PinToggle}">
                  <common:AppIcon Kind="{x:Bind features:ClipItemIcons.Pin(IsPinned), Mode=OneWay}"
                                  Width="16"
                                  Height="16" />
                </Button>
                <Button Command="{x:Bind DeleteCommand}"
                        ToolTipService.ToolTip="{l:Tr Key=Panel_Delete}"
                        AutomationProperties.Name="{l:Tr Key=Panel_Delete}">
                  <common:AppIcon Kind="Delete" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <common:LoadStateOverlay State="{x:Bind ViewModel.State, Mode=OneWay}"
                               ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               EmptyText="{l:Tr Key=Panel_Empty}"
                               RetryCommand="{x:Bind ViewModel.ReloadCommand, Mode=OneWay}" />
    </Grid>

    <!-- Footer: clear all with an inline confirmation -->
    <Grid Grid.Row="2" Padding="8">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Visibility="{x:Bind common:BoolToVisibility.Collapsed(ViewModel.IsConfirmingClear), Mode=OneWay}">
        <Button Command="{x:Bind ViewModel.RequestClearCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <common:AppIcon Kind="Delete" Width="16" Height="16" />
            <TextBlock Text="{l:Tr Key=Panel_ClearAll}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8"
                  Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.IsConfirmingClear), Mode=OneWay}">
        <TextBlock Text="{l:Tr Key=Panel_ClearConfirm}" VerticalAlignment="Center" />
        <Button Content="{l:Tr Key=Panel_ClearYes}" Command="{x:Bind ViewModel.ConfirmClearCommand}" />
        <Button Content="{l:Tr Key=Common_Cancel}" Command="{x:Bind ViewModel.CancelClearCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
