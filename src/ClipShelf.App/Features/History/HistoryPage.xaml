<UserControl x:Class="ClipShelf.App.Features.History.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ClipShelf.App.Localization"
             xmlns:common="using:ClipShelf.App.Common">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="24,18,24,0">
      <TextBlock Text="{l:Tr Key=History_Title}" Style="{StaticResource TitleTextBlockStyle}" />
      <TextBlock Text="{l:Tr Key=History_Description}"
                 Style="{StaticResource BodyTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>

    <!-- Search and the category filter -->
    <Grid Grid.Row="1" Margin="24,12,24,6" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="SearchBox"
               Height="36"
               CornerRadius="{StaticResource CardRadius}"
               IsEnabled="{x:Bind ViewModel.CanSearch, Mode=OneWay}"
               PlaceholderText="{l:Tr Key=Panel_SearchPlaceholder}"
               Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox Grid.Column="1"
                x:Name="CategoryFilter"
                MinWidth="180"
                MinHeight="36"
                AutomationProperties.Name="{l:Tr Key=History_Filter}"
                ItemsSource="{x:Bind ViewModel.CategoryFilterOptions}"
                DisplayMemberPath="Label"
                SelectedItem="{x:Bind ViewModel.SelectedCategoryFilter, Mode=TwoWay}"
                SelectionChanged="OnCategoryFilterChanged"
                DropDownClosed="OnCategoryFilterDropDownClosed" />
    </Grid>

    <!-- Grouped history (Pinned, then Recent) on a card surface, with its loading/empty/error overlay -->
    <Grid Grid.Row="2">
      <Border Margin="24,4,24,8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource CardRadius}"
              Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.HasItems), Mode=OneWay}">
        <ListView x:Name="ClipList"
                  Padding="8,8,8,4"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  ItemTemplate="{StaticResource ClipItemTemplate}">
          <ListView.Resources>
            <!-- Rows are click-to-copy; a hovering fill reads like a selection in dark theme.
                 The pin and delete buttons keep their own hover state. -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
          </ListView.Resources>
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0,7" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="CornerRadius" Value="4" />
              <!-- Clicking a row copies it; keep the row from staying highlighted afterwards. -->
              <Setter Property="AllowFocusOnInteraction" Value="False" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Title}"
                             Style="{StaticResource BodyStrongTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             Margin="0,12,0,2" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListView.GroupStyle>
        </ListView>
      </Border>

      <common:LoadStateOverlay State="{x:Bind ViewModel.State, Mode=OneWay}"
                               ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               EmptyText="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                               EmptyHint="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                               RetryCommand="{x:Bind ViewModel.ReloadCommand, Mode=OneWay}" />
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="3"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <Grid Padding="24,8" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{x:Bind ViewModel.FooterText, Mode=OneWay}"
                   VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{l:Tr Key=Selection_Select}"
                  MinWidth="0"
                  Height="28"
                  Padding="12,4"
                  FontSize="13"
                  HorizontalContentAlignment="Center"
                  Command="{x:Bind ViewModel.ToggleSelectionCommand}"
                  Visibility="{x:Bind ViewModel.ShowSelectButton, Mode=OneWay, Converter={StaticResource BoolVisible}}" />
          <Button Content="{l:Tr Key=Common_Cancel}"
                  MinWidth="0"
                  Height="28"
                  Padding="12,4"
                  FontSize="13"
                  HorizontalContentAlignment="Center"
                  Command="{x:Bind ViewModel.ToggleSelectionCommand}"
                  Visibility="{x:Bind ViewModel.IsSelecting, Mode=OneWay, Converter={StaticResource BoolVisible}}" />
          <Button Content="{l:Tr Key=Selection_Copy}"
                  MinWidth="0"
                  Height="28"
                  Padding="12,4"
                  FontSize="13"
                  HorizontalContentAlignment="Center"
                  IsEnabled="{x:Bind ViewModel.CanCopySelection, Mode=OneWay}"
                  Command="{x:Bind ViewModel.CopySelectedCommand}"
                  Visibility="{x:Bind ViewModel.IsSelecting, Mode=OneWay, Converter={StaticResource BoolVisible}}" />
          <Button x:Name="ClearAllButton"
                  Background="Transparent"
                  BorderThickness="0"
                  Width="32"
                  Height="28"
                  Padding="0"
                  IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                  ToolTipService.ToolTip="{l:Tr Key=Panel_ClearAll}"
                  AutomationProperties.Name="{l:Tr Key=Panel_ClearAll}"
                  Command="{x:Bind ViewModel.RequestClearCommand}"
                  Visibility="{x:Bind ViewModel.ShowSelectButton, Mode=OneWay, Converter={StaticResource BoolVisible}}">
            <common:AppIcon Kind="Delete" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- In-window confirmation panel (over the content, Esc cancels) -->
    <Grid Grid.Row="0"
          Grid.RowSpan="4"
          Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.IsConfirmingClear), Mode=OneWay}">
      <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.7" />
      <Border Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource CardRadius}"
              Padding="16"
              Width="300"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{l:Tr Key=Panel_ClearConfirm}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ConfirmClearButton"
                    Content="{l:Tr Key=Panel_ClearYes}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.ConfirmClearCommand}" />
            <Button Content="{l:Tr Key=Common_Cancel}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{x:Bind ViewModel.CancelClearCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
