<Window x:Class="ClipShelf.App.Features.History.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.App.Localization"
        xmlns:common="using:ClipShelf.App.Common">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search: no background, no underline -->
    <Grid Grid.Row="0" Margin="20,18,20,8">
      <TextBox x:Name="SearchBox"
               Height="38"
               Padding="30,0,10,0"
               PlaceholderText="{l:Tr Key=Panel_SearchPlaceholder}"
               Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <TextBox.Resources>
          <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
          <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
          <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
        </TextBox.Resources>
      </TextBox>
      <common:AppIcon Kind="Search"
                      Width="16"
                      Height="16"
                      Margin="10,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>

    <!-- Full history with its loading/empty/error overlay -->
    <Grid Grid.Row="1">
      <ListView Padding="12,0"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                ItemTemplate="{StaticResource ClipItemTemplate}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnItemClick">
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
          </Style>
        </ListView.ItemContainerStyle>
      </ListView>

      <common:LoadStateOverlay State="{x:Bind ViewModel.State, Mode=OneWay}"
                               ErrorMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                               EmptyText="{l:Tr Key=Panel_Empty}"
                               RetryCommand="{x:Bind ViewModel.ReloadCommand, Mode=OneWay}" />
    </Grid>

    <!-- Footer: clear all with an inline confirmation -->
    <Border Grid.Row="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
      <Grid Padding="14,8">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Visibility="{x:Bind common:BoolToVisibility.Collapsed(ViewModel.IsConfirmingClear), Mode=OneWay}">
          <Button Background="Transparent"
                  BorderThickness="0"
                  MinHeight="30"
                  Padding="10,4"
                  IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}"
                  Command="{x:Bind ViewModel.RequestClearCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <common:AppIcon Kind="Delete" Width="15" Height="15" />
              <TextBlock Text="{l:Tr Key=Panel_ClearAll}" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Visibility="{x:Bind common:BoolToVisibility.Visible(ViewModel.IsConfirmingClear), Mode=OneWay}">
          <TextBlock Text="{l:Tr Key=Panel_ClearConfirm}" VerticalAlignment="Center" />
          <Button Content="{l:Tr Key=Panel_ClearYes}" MinHeight="30" Command="{x:Bind ViewModel.ConfirmClearCommand}" />
          <Button Content="{l:Tr Key=Common_Cancel}" MinHeight="30" Command="{x:Bind ViewModel.CancelClearCommand}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
