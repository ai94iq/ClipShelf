<UserControl x:Class="ClipShelf.App.Common.LoadStateOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ClipShelf.App.Localization">
  <!-- Put this on top of the page content in the same Grid cell. Usage: see PageViewModel. -->
  <Grid>
    <ProgressRing IsActive="True"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="{x:Bind State, Mode=OneWay, Converter={StaticResource LoadStateVisible}, ConverterParameter=Loading}" />

    <TextBlock Text="{x:Bind EmptyText, Mode=OneWay}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextWrapping="Wrap"
               Visibility="{x:Bind State, Mode=OneWay, Converter={StaticResource LoadStateVisible}, ConverterParameter=Empty}" />

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                Visibility="{x:Bind State, Mode=OneWay, Converter={StaticResource LoadStateVisible}, ConverterParameter=Error}">
      <TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
      <Button Content="{l:Tr Key=Common_Retry}"
              Command="{x:Bind RetryCommand, Mode=OneWay}"
              HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
