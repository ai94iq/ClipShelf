<Window x:Class="ClipShelf.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="using:ClipShelf.App.Common"
        xmlns:l="using:ClipShelf.App.Localization">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Draggable title area; caption buttons are drawn by Windows -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0">
      <TextBlock Text="{l:Tr Key=App_Name}"
                 VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextBlockStyle}" />
      <TextBox x:Name="SettingsSearchBox"
               Width="360"
               Height="32"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               CornerRadius="{StaticResource CardRadius}"
               PlaceholderText="{l:Tr Key=Settings_SearchPlaceholder}"
               TextChanged="OnSettingsSearchChanged"
               Visibility="Collapsed" />
    </Grid>

    <NavigationView x:Name="Nav"
                    Grid.Row="1"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    PaneDisplayMode="LeftCompact"
                    OpenPaneLength="180"
                    SelectionChanged="OnSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="{l:Tr Key=Nav_History}" Tag="history">
          <NavigationViewItem.Icon>
            <PathIcon Data="{common:IconData Kind=Document}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem Content="{l:Tr Key=Nav_Settings}" Tag="settings">
          <NavigationViewItem.Icon>
            <PathIcon Data="{common:IconData Kind=Settings}" />
          </NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.FooterMenuItems>

      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
