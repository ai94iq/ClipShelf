<Window x:Class="ClipShelf.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.App.Localization">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Draggable title area; caption buttons are drawn by Windows and follow RTL automatically -->
    <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0">
      <TextBlock Text="{l:Tr Key=App_Name}"
                 VerticalAlignment="Center"
                 Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>

    <!-- Replace with NavigationView when the first feature is added -->
    <TextBlock Grid.Row="1"
               Text="{l:Tr Key=App_Welcome}"
               Style="{StaticResource SubtitleTextBlockStyle}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
  </Grid>
</Window>
