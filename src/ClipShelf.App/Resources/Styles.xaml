<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="using:ClipShelf.App.Common"
                    xmlns:l="using:ClipShelf.App.Localization"
                    xmlns:features="using:ClipShelf.App.Features.ClipboardPanel">
  <!-- Shared resources only. Feature-specific styles stay in the feature folder. -->
  <common:LoadStateToVisibilityConverter x:Key="LoadStateVisible" />
  <common:PinIconConverter x:Key="PinIcon" />
  <common:BoolToVisibilityConverter x:Key="BoolVisible" />
  <common:BytesToImageConverter x:Key="BytesToImage" />
  <common:ErrorBrushConverter x:Key="ErrorBrush" />
  <common:SuccessBrushConverter x:Key="SuccessBrush" />
  <common:AccentSwatchConverter x:Key="AccentSwatch" />

  <!-- App font: the system Segoe stack, or the bundled Noto Sans Arabic in an Arabic UI.
       Control text uses the ContentControlThemeFontFamily key, set in App.OnLaunched. -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{l:AppFont}" />
  </Style>

  <!-- Icons take the secondary text color on every theme (destructive buttons tint them on hover). -->
  <Style TargetType="common:AppIcon">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- Error messages: the critical system brush, red in every theme. -->
  <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Spacing tokens (4 px grid). Use these instead of literal margins. -->
  <Thickness x:Key="PagePadding">24</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,32</Thickness>
  <Thickness x:Key="FieldSpacing">0,0,0,16</Thickness>
  <Thickness x:Key="LabelSpacing">0,0,0,4</Thickness>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>

  <!-- A settings group: one rounded surface holding rows, a hairline between them. -->
  <Style x:Key="SettingsGroupBorder" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
  </Style>
  <Style x:Key="SettingsGroupDivider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- Deferred-delete bar: "Clip deleted  [Undo]" shown while undo is still possible. -->
  <Style x:Key="UndoBarBorder" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- One history row, used by the flyout and the full history window.
       Classic {Binding} because x:Bind needs a code-behind class in a resource dictionary. -->
  <DataTemplate x:Key="ClipItemTemplate">
    <Grid ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Select mode indicator: the row itself is the hit target, so the box only shows state. -->
      <CheckBox Grid.Column="0"
                MinWidth="0"
                Padding="0"
                VerticalAlignment="Center"
                AllowFocusOnInteraction="False"
                IsTabStop="False"
                IsHitTestVisible="False"
                IsChecked="{Binding IsSelected, Mode=OneWay}"
                Visibility="{Binding ShowSelection, Converter={StaticResource BoolVisible}}" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Border Visibility="{Binding HasImage, Converter={StaticResource BoolVisible}}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                HorizontalAlignment="{common:RtlAlign Desired=Left}"
                Margin="0,2">
          <Image Source="{Binding ThumbnailBytes, Converter={StaticResource BytesToImage}}"
                 MaxWidth="160"
                 MaxHeight="72"
                 Stretch="Uniform" />
        </Border>
        <TextBlock Text="{Binding Preview}"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Visibility="{Binding ShowPreview, Converter={StaticResource BoolVisible}}" />
        <TextBlock Text="{Binding SourceText}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
        <Button Background="Transparent"
                BorderThickness="0"
                Width="30"
                Height="30"
                Padding="0"
                AllowFocusOnInteraction="False"
                Command="{Binding TogglePinCommand}"
                ToolTipService.ToolTip="{l:Tr Key=Panel_PinToggle}"
                AutomationProperties.Name="{l:Tr Key=Panel_PinToggle}">
          <common:AppIcon Kind="{Binding IsPinned, Converter={StaticResource PinIcon}}" Width="16" Height="16" />
        </Button>
        <Button Background="Transparent"
                BorderThickness="0"
                Width="30"
                Height="30"
                Padding="0"
                AllowFocusOnInteraction="False"
                Command="{Binding CategoryCommand}"
                ToolTipService.ToolTip="{l:Tr Key=Panel_Category}"
                AutomationProperties.Name="{l:Tr Key=Panel_Category}">
          <common:AppIcon Kind="Folder" Width="16" Height="16" />
        </Button>
        <Button Background="Transparent"
                BorderThickness="0"
                Width="30"
                Height="30"
                Padding="0"
                AllowFocusOnInteraction="False"
                Command="{Binding DeleteCommand}"
                ToolTipService.ToolTip="{l:Tr Key=Panel_Delete}"
                AutomationProperties.Name="{l:Tr Key=Panel_Delete}">
          <common:AppIcon Kind="Delete" Width="16" Height="16" />
        </Button>
      </StackPanel>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
