<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="using:ClipShelf.App.Common">
  <!-- Shared resources only. Feature-specific styles stay in the feature folder. -->
  <common:LoadStateToVisibilityConverter x:Key="LoadStateVisible" />

  <!-- App font: overrides the theme font key used by every control and text style -->
  <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/NotoSansArabic-Regular.ttf#Noto Sans Arabic</FontFamily>
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
  </Style>

  <!-- Spacing tokens (4 px grid). Use these instead of literal margins. -->
  <Thickness x:Key="PagePadding">24</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,32</Thickness>
  <Thickness x:Key="FieldSpacing">0,0,0,16</Thickness>
  <Thickness x:Key="LabelSpacing">0,0,0,4</Thickness>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
</ResourceDictionary>
