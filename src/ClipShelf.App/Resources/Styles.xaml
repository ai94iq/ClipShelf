<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="using:ClipShelf.App.Common"
                    xmlns:l="using:ClipShelf.App.Localization"
                    xmlns:features="using:ClipShelf.App.Features.ClipboardPanel">
  <!-- Shared resources only. Feature-specific styles stay in the feature folder. -->
  <common:LoadStateToVisibilityConverter x:Key="LoadStateVisible" />

  <!-- App font: overrides the theme font key used by every control and text style -->
  <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/NotoSansArabic-Regular.ttf#Noto Sans Arabic</FontFamily>
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
  </Style>

  <!-- Spacing tokens (4 px grid). Use these instead of literal margins. -->
  <Thickness x:Key="PagePadding">24</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,32</Thickness>
  <Thickness x:Key="FieldSpacing">0,0,0,16</Thickness>
  <Thickness x:Key="LabelSpacing">0,0,0,4</Thickness>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>

  <!-- One history row, used by the flyout and the full history window.
       Classic {Binding} because x:Bind needs a code-behind class in a resource dictionary. -->
  <DataTemplate x:Key="ClipItemTemplate">
    <Grid ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Preview}"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />
        <TextBlock Text="{Binding SourceText}"
                   FontSize="11"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
        <Button Background="Transparent"
                BorderThickness="0"
                Width="28"
                Height="28"
                Padding="0"
                Command="{Binding TogglePinCommand}"
                ToolTipService.ToolTip="{l:Tr Key=Panel_PinToggle}"
                AutomationProperties.Name="{l:Tr Key=Panel_PinToggle}">
          <common:AppIcon Kind="{Binding PinIconKind}" Width="14" Height="14" />
        </Button>
        <Button Background="Transparent"
                BorderThickness="0"
                Width="28"
                Height="28"
                Padding="0"
                Command="{Binding DeleteCommand}"
                ToolTipService.ToolTip="{l:Tr Key=Panel_Delete}"
                AutomationProperties.Name="{l:Tr Key=Panel_Delete}">
          <common:AppIcon Kind="Delete" Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
