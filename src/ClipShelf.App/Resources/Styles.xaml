<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:common="using:ClipShelf.App.Common"
                    xmlns:l="using:ClipShelf.App.Localization"
                    xmlns:features="using:ClipShelf.App.Features.ClipboardPanel">
  <!-- Shared resources only. Feature-specific styles stay in the feature folder. -->
  <common:LoadStateToVisibilityConverter x:Key="LoadStateVisible" />
  <common:PinIconConverter x:Key="PinIcon" />
  <common:BoolToVisibilityConverter x:Key="BoolVisible" />
  <common:BytesToImageConverter x:Key="BytesToImage" />
  <common:AccentSwatchConverter x:Key="AccentSwatch" />

  <!-- Hover washes: the accent at a readable strength. Styles.xaml is merged last, so these entries
       are searched before the framework's theme dictionaries and win app-wide. -->
  <SolidColorBrush x:Key="AccentHoverWash" Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />
  <SolidColorBrush x:Key="AccentHoverWashStrong" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />
  <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
  <SolidColorBrush x:Key="ToggleMenuFlyoutItemBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />
  <SolidColorBrush x:Key="ToggleMenuFlyoutItemBackgroundPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.25" />
  <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.35" />

  <!-- The row action buttons own their template, so the hover wash is read straight from this
       dictionary and cannot lose a lookup. -->
  <Style x:Key="RowActionButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent" CornerRadius="4">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerOver">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentHoverWash}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Pressed">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource AccentHoverWashStrong}" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                      <DiscreteObjectKeyFrame KeyTime="0" Value="Transparent" />
                    </ObjectAnimationUsingKeyFrames>
                  </Storyboard>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The soft accent wash that marks a selected row (keyboard row, Select mode). -->
  <SolidColorBrush x:Key="AccentWash" Color="{ThemeResource SystemAccentColor}" Opacity="0.16" />

  <!-- App font: the system Segoe stack, or the bundled Noto Sans Arabic in an Arabic UI.
       Control text uses the ContentControlThemeFontFamily key, set in App.OnLaunched. -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{l:AppFont}" />
  </Style>

  <!-- Icons take the secondary text color on every theme (destructive buttons tint them on hover). -->
  <Style TargetType="common:AppIcon">
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
  </Style>

  <!-- Error messages: the critical system brush, red in every theme. -->
  <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Spacing tokens (4 px grid). Use these instead of literal margins. -->
  <Thickness x:Key="PagePadding">24</Thickness>
  <Thickness x:Key="SectionSpacing">0,0,0,32</Thickness>
  <Thickness x:Key="FieldSpacing">0,0,0,16</Thickness>
  <Thickness x:Key="LabelSpacing">0,0,0,4</Thickness>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>

  <!-- A settings group: one rounded surface holding rows, a hairline between them. -->
  <Style x:Key="SettingsGroupBorder" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
  </Style>
  <Style x:Key="SettingsGroupDivider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
  </Style>

  <!-- Deferred-delete bar: "Clip deleted  [Undo]" shown while undo is still possible. -->
  <Style x:Key="UndoBarBorder" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorTertiaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- One history row, used by the flyout and the full history window.
       Classic {Binding} because x:Bind needs a code-behind class in a resource dictionary. -->
  <DataTemplate x:Key="ClipItemTemplate">
    <Grid ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Checked rows in Select mode wear the accent wash; the current row's wash comes from
           the list itself. -->
      <Border Grid.ColumnSpan="3"
              Background="{StaticResource AccentWash}"
              CornerRadius="4"
              Visibility="{Binding IsSelected, Converter={StaticResource BoolVisible}}" />

      <!-- Select mode indicator: the row itself is the hit target, so the box only shows state. -->
      <CheckBox Grid.Column="0"
                MinWidth="0"
                Padding="0"
                VerticalAlignment="Center"
                AllowFocusOnInteraction="False"
                IsTabStop="False"
                IsHitTestVisible="False"
                IsChecked="{Binding IsSelected, Mode=OneWay}"
                Visibility="{Binding ShowSelection, Converter={StaticResource BoolVisible}}" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Border Visibility="{Binding HasImage, Converter={StaticResource BoolVisible}}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                HorizontalAlignment="{common:RtlAlign Desired=Left}"
                Margin="0,2">
          <Image Source="{Binding ThumbnailBytes, Converter={StaticResource BytesToImage}}"
                 MaxWidth="160"
                 MaxHeight="72"
                 Stretch="Uniform" />
        </Border>
        <TextBlock Text="{Binding Preview}"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Visibility="{Binding ShowPreview, Converter={StaticResource BoolVisible}}" />
        <TextBlock Text="{Binding SourceText}"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
        <Button Style="{StaticResource RowActionButton}"
                AllowFocusOnInteraction="False"
                Command="{Binding TogglePinCommand}"
                ToolTipService.ToolTip="{l:Tr Key=Panel_PinToggle}"
                AutomationProperties.Name="{l:Tr Key=Panel_PinToggle}">
          <common:AppIcon Kind="{Binding IsPinned, Converter={StaticResource PinIcon}}" Width="16" Height="16" />
        </Button>
        <Button Style="{StaticResource RowActionButton}"
                AllowFocusOnInteraction="False"
                Command="{Binding CategoryCommand}"
                ToolTipService.ToolTip="{l:Tr Key=Panel_Category}"
                AutomationProperties.Name="{l:Tr Key=Panel_Category}">
          <common:AppIcon Kind="Folder" Width="16" Height="16" />
        </Button>
        <Button Style="{StaticResource RowActionButton}"
                AllowFocusOnInteraction="False"
                Command="{Binding DeleteCommand}"
                ToolTipService.ToolTip="{l:Tr Key=Panel_Delete}"
                AutomationProperties.Name="{l:Tr Key=Panel_Delete}">
          <common:AppIcon Kind="Delete" Width="16" Height="16" />
        </Button>
      </StackPanel>
    </Grid>
  </DataTemplate>
</ResourceDictionary>
