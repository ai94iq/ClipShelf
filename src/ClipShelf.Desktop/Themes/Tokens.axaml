<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The Construction Grid: committed tokens. Light and Dark scopes; the Black theme overrides
       the ground and line brushes at runtime from the theme service. The accent hue is replaced
       from the user's accent setting; the world's blue is the default. Display type stays the
       system grotesk at display sizes with tight tracking: the identity is structure, not a face. -->

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="GridPaperBrush" Color="#F7F7F4" />
      <SolidColorBrush x:Key="GridCellBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="GridInkBrush" Color="#111111" />
      <SolidColorBrush x:Key="GridLineBrush" Color="#E4E7EC" />
      <SolidColorBrush x:Key="GridMutedBrush" Color="#43474D" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="GridPaperBrush" Color="#0E0F11" />
      <SolidColorBrush x:Key="GridCellBrush" Color="#16181B" />
      <SolidColorBrush x:Key="GridInkBrush" Color="#F2F2EF" />
      <SolidColorBrush x:Key="GridLineBrush" Color="#26282C" />
      <SolidColorBrush x:Key="GridMutedBrush" Color="#9AA0A8" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- The committed shell ground: one stark saturated rail, the same in every theme. -->
  <SolidColorBrush x:Key="GridRailBrush" Color="#0057FF" />
  <SolidColorBrush x:Key="GridRailInkBrush" Color="#FFFFFF" />

  <!-- The single accent plane. The theme service replaces the color from the user's setting. -->
  <Color x:Key="GridAccentColor">#0057FF</Color>
  <SolidColorBrush x:Key="GridAccentBrush" Color="#0057FF" />
  <SolidColorBrush x:Key="GridAccentPlaneBrush" Color="#0057FF" Opacity="0.12" />
  <SolidColorBrush x:Key="GridAccentInkBrush" Color="#FFFFFF" />

  <!-- Type ramp and rhythm. -->
  <x:Double x:Key="GridDisplaySize">44</x:Double>
  <x:Double x:Key="GridTitleSize">20</x:Double>
  <x:Double x:Key="GridBodySize">14</x:Double>
  <x:Double x:Key="GridLabelSize">11</x:Double>
  <x:Double x:Key="GridPitch">24</x:Double>
</ResourceDictionary>
