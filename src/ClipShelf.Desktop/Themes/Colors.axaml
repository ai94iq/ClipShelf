<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light theme colors -->
  <SolidColorBrush x:Key="SurfaceBackground" Color="#F5F5F7" />
  <SolidColorBrush x:Key="SurfaceCard" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceElevated" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceOverlay" Color="#E8E8ED" />

  <SolidColorBrush x:Key="TextPrimary" Color="#1A1A2E" />
  <SolidColorBrush x:Key="TextSecondary" Color="#5A5A72" />
  <SolidColorBrush x:Key="TextMuted" Color="#8A8A9E" />
  <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF" />

  <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
  <SolidColorBrush x:Key="AccentPressBrush" Color="#1D4ED8" />
  <SolidColorBrush x:Key="AccentSubtleBrush" Color="#DBEAFE" />

  <SolidColorBrush x:Key="BorderSubtle" Color="#E5E5EA" />
  <SolidColorBrush x:Key="BorderDefault" Color="#D1D1D8" />

  <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
  <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#FEE2E2" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />

  <SolidColorBrush x:Key="HoverOverlay" Color="#1A1A2E" Opacity="0.06" />
  <SolidColorBrush x:Key="DividerBrush" Color="#E5E5EA" />

  <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SidebarBorder" Color="#E5E5EA" />

  <SolidColorBrush x:Key="ShadowColor" Color="#1A1A2E" Opacity="0.12" />

  <!-- Spacing tokens -->
  <x:Double x:Key="FontSizeDisplay">32</x:Double>
  <x:Double x:Key="FontSizeHeadline">24</x:Double>
  <x:Double x:Key="FontSizeTitle2">20</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeBodySmall">13</x:Double>
  <x:Double x:Key="FontSizeCaption">12</x:Double>

  <x:Double x:Key="RadiusSmall">6</x:Double>
  <x:Double x:Key="RadiusMedium">10</x:Double>
  <x:Double x:Key="RadiusLarge">14</x:Double>
  <x:Double x:Key="RadiusXLarge">20</x:Double>
  <x:Double x:Key="RadiusFull">9999</x:Double>

</ResourceDictionary>