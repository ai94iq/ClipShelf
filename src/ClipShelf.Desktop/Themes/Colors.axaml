<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- One source of truth: FluentTheme. These aliases exist only because the
       clip views speak in ClipShelf words (surface, card, muted text) rather
       than Fluent's SystemControl names. Every value resolves to a key that
       was measured in Avalonia.Themes.Fluent 11.3.22, so light and dark both
       come from Fluent and there is no second palette to drift.
       Do not add a literal color here unless Fluent genuinely has no key. -->
  <StaticResource x:Key="SurfaceBackground" ResourceKey="SystemControlBackgroundChromeMediumLowBrush" />
  <StaticResource x:Key="SurfaceCard" ResourceKey="SystemControlBackgroundAltHighBrush" />
  <StaticResource x:Key="SurfaceElevated" ResourceKey="SystemControlBackgroundAltMediumHighBrush" />
  <StaticResource x:Key="SurfaceOverlay" ResourceKey="FlyoutPresenterBackground" />

  <StaticResource x:Key="TextPrimary" ResourceKey="SystemControlForegroundBaseHighBrush" />
  <StaticResource x:Key="TextSecondary" ResourceKey="SystemControlForegroundBaseMediumBrush" />
  <StaticResource x:Key="TextMuted" ResourceKey="SystemControlForegroundBaseMediumHighBrush" />
  <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFFFF" />

  <StaticResource x:Key="AccentBrush" ResourceKey="SystemControlForegroundAccentBrush" />
  <StaticResource x:Key="AccentHoverBrush" ResourceKey="AccentButtonBackgroundPointerOver" />
  <StaticResource x:Key="AccentPressBrush" ResourceKey="AccentButtonBackgroundPressed" />
  <!-- Fluent has no translucent accent tint; this is its neutral low wash,
       which is what Fluent's own selection surfaces use. -->
  <StaticResource x:Key="AccentSubtleBrush" ResourceKey="SystemControlHighlightListLowBrush" />

  <StaticResource x:Key="BorderSubtle" ResourceKey="SystemControlBackgroundListLowBrush" />
  <StaticResource x:Key="BorderDefault" ResourceKey="SystemControlTransientBorderBrush" />

  <StaticResource x:Key="ErrorBrush" ResourceKey="SystemControlErrorTextForegroundBrush" />
  <StaticResource x:Key="ErrorSubtleBrush" ResourceKey="NotificationCardErrorBackgroundBrush" />
  <StaticResource x:Key="SuccessBrush" ResourceKey="NotificationCardSuccessBackgroundBrush" />

  <StaticResource x:Key="HoverOverlay" ResourceKey="SystemControlHighlightListLowBrush" />
  <StaticResource x:Key="DividerBrush" ResourceKey="SystemControlBackgroundListLowBrush" />
  <StaticResource x:Key="SidebarBackground" ResourceKey="SystemControlBackgroundBaseLowBrush" />
  <StaticResource x:Key="SidebarBorder" ResourceKey="SystemControlTransientBorderBrush" />

  <!-- A shadow is not a theme color: it is geometry over whatever is behind
       it, so it stays a fixed translucent black in both variants. -->
  <SolidColorBrush x:Key="ShadowColor" Color="#33000000" />

  <x:Double x:Key="FontSizeDisplay">32</x:Double>
  <x:Double x:Key="FontSizeHeadline">24</x:Double>
  <x:Double x:Key="FontSizeTitle2">20</x:Double>
  <x:Double x:Key="FontSizeBody">14</x:Double>
  <x:Double x:Key="FontSizeBodySmall">13</x:Double>
  <x:Double x:Key="FontSizeCaption">12</x:Double>

  <!-- Fluent's ControlCornerRadius is 4; larger steps are ours. -->
  <x:Double x:Key="RadiusSmall">4</x:Double>
  <x:Double x:Key="RadiusMedium">4</x:Double>
  <x:Double x:Key="RadiusLarge">8</x:Double>
  <x:Double x:Key="RadiusXLarge">12</x:Double>
  <x:Double x:Key="RadiusFull">9999</x:Double>

</ResourceDictionary>