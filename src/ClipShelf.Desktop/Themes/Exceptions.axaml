<!-- The only literal colors in the app. Views use Fluent keys through DynamicResource; an entry
     belongs here only when Fluent has no key for the job, and its comment names the gap. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="using:ClipShelf.Desktop.Services">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Fluent has no translucent accent tint for a selected rail item or row: the accent at
           low opacity, so it follows the chosen accent. -->
      <SolidColorBrush x:Key="ClipShelfAccentSubtleBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.15" />
      <!-- Fluent has no card elevation shadow. -->
      <BoxShadows x:Key="ClipShelfCardShadow">0 4 16 -4 #1A000000</BoxShadows>
      <!-- Fluent has no layered window surfaces (its window and cards share one white): main's
           soft gray canvas under white cards, so the groups read apart. -->
      <SolidColorBrush x:Key="ClipShelfCanvasBrush" Color="#E6E6E6" />
      <SolidColorBrush x:Key="ClipShelfCardBrush" Color="#FFFFFF" />
      <!-- The content layer between canvas and cards (main's LayerFillColorDefault). -->
      <SolidColorBrush x:Key="ClipShelfLayerBrush" Color="#EFEFEF" />
      <!-- Fluent has no caption buttons, so no close-button red. -->
      <SolidColorBrush x:Key="ClipShelfCaptionCloseBrush" Color="#C42B1C" />
      <!-- Fluent here is v1: buttons 20% black, inputs 40% white with a 60% black border, heavier
           than main's WinUI 3 controls. Rest, hover and press take WinUI 3's ControlFillColor
           and ControlStrokeColor values; focus stays Fluent's. A disabled input takes
           ControlFillColorDisabled: Fluent's disabled gray read as a dark block (seen on macOS). -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#B3FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#80F9F9F9" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4DF9F9F9" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#0F000000" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#0F000000" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#B3FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#80F9F9F9" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#4DF9F9F9" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#29000000" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#29000000" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#29000000" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#B3FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#80F9F9F9" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#29000000" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#29000000" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#4DF9F9F9" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#0F000000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="ClipShelfAccentSubtleBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.25" />
      <BoxShadows x:Key="ClipShelfCardShadow">0 4 16 -4 #66000000</BoxShadows>
      <!-- Windows 11 dark layers: the base surface, and cards a step lighter. -->
      <SolidColorBrush x:Key="ClipShelfCanvasBrush" Color="#202020" />
      <!-- WinUI's dark CardBackgroundFillColorDefault, a 5% white wash: it reads #2B2B2B over the
           opaque canvas and lets Mica or Acrylic through (solid cards hid the backdrop). -->
      <SolidColorBrush x:Key="ClipShelfCardBrush" Color="#0DFFFFFF" />
      <!-- A faint white wash, so the layer reads over Mica as well as over the canvas. -->
      <SolidColorBrush x:Key="ClipShelfLayerBrush" Color="#0DFFFFFF" />
      <SolidColorBrush x:Key="ClipShelfCaptionCloseBrush" Color="#C42B1C" />
      <!-- Fluent's dark transient border is near black, so card and group edges vanished on the
           dark canvas; a faint white edge, as WinUI's dark CardStrokeColor reads. -->
      <SolidColorBrush x:Key="SystemControlTransientBorderBrush" Color="#1FFFFFFF" />
      <!-- Fluent draws accent text and glyphs with the base accent in every theme; on dark
           surfaces it is too dark to read, so Dark takes the Light3 shade, as WinUI's
           AccentTextFillColorPrimary does (Light takes Dark2 in ThemeService). -->
      <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="{DynamicResource SystemAccentColorLight3}" />
      <SolidColorBrush x:Key="ButtonBackground" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#15FFFFFF" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#08FFFFFF" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#12FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#15FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#08FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#28FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#28FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#28FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#15FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#28FFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#28FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0BFFFFFF" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#12FFFFFF" />
    </ResourceDictionary>
    <!-- Full black: black throughout, for OLED screens; the borders keep the layers apart.
         Everything not listed here comes from Dark. -->
    <ResourceDictionary x:Key="{x:Static services:ThemeService.Black}">
      <SolidColorBrush x:Key="ClipShelfCanvasBrush" Color="#000000" />
      <SolidColorBrush x:Key="ClipShelfCardBrush" Color="#000000" />
      <SolidColorBrush x:Key="ClipShelfLayerBrush" Color="#000000" />
      <!-- Dark's border is near black, so black cards on black would merge into one sheet. -->
      <SolidColorBrush x:Key="SystemControlTransientBorderBrush" Color="#3A3A3A" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
