<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClipShelf.Desktop.Controls"
             xmlns:l="using:ClipShelf.Desktop.Common"
             xmlns:vm="using:ClipShelf.Presentation.Features.ClipboardPanel"
             x:Class="ClipShelf.Desktop.Views.HistoryPage"
             x:DataType="vm:ClipboardPanelViewModel">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="HistoryCopyNoticeBrush" Color="#0F7B0F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="HistoryCopyNoticeBrush" Color="#6CCB5F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="24,18,24,0" Spacing="2">
      <TextBlock Text="{l:Tr Key=History_Title}" Classes="grid-title" />
      <TextBlock Text="{l:Tr Key=History_Description}" Classes="grid-label" />
    </StackPanel>

    <!-- Search and the category filter -->
    <Grid Grid.Row="1" Margin="24,12,24,6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox x:Name="SearchBox"
               Grid.Column="0"
               Height="36"
               IsEnabled="{Binding CanSearch}"
               PlaceholderText="{l:Tr Key=Panel_SearchPlaceholder}"
               Text="{Binding SearchText, Mode=TwoWay}" />
      <ComboBox x:Name="CategoryFilter"
                Grid.Column="1"
                MinWidth="180"
                MinHeight="36"
                ItemsSource="{Binding CategoryFilterOptions}"
                SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                SelectionChanged="OnCategoryFilterChanged"
                DropDownClosed="OnCategoryFilterDropDownClosed">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
        <ComboBox.SelectionBoxItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.SelectionBoxItemTemplate>
      </ComboBox>
    </Grid>

    <!-- Grouped history (Pinned, then Recent) with its loading/empty/error overlay -->
    <Grid Grid.Row="2">
      <Border Margin="24,4,24,8"
              Background="{DynamicResource GridCellBrush}"
              BorderBrush="{DynamicResource GridLineBrush}"
              BorderThickness="1"
              CornerRadius="4"
              IsVisible="{Binding HasItems}">
        <ScrollViewer x:Name="HistoryScroll"
                      Padding="8,8,8,4"
                      ScrollChanged="OnScrollChanged">
          <ItemsControl x:Name="GroupsList"
                        ItemsSource="{Binding Groups}"
                        PointerPressed="OnGroupsPointerPressed">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,12,0,2">
                  <TextBlock Text="{Binding Title}"
                             Classes="grid-label"
                             Margin="0,0,0,2" />
                  <ItemsControl ItemsSource="{Binding}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="clip-row"
                                Margin="0,7"
                                Padding="10,8"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding ActivateCommand}"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource ClipCellTemplate}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <!-- Load states sit over the list: the quiet refresh never flashes them over content,
           because Error only sticks before the first load and Empty means zero rows. -->
      <StackPanel Spacing="8"
                  Margin="32,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding State, Converter={StaticResource StateEquals}, ConverterParameter='Idle,Loading'}">
        <ProgressBar Width="120"
                     IsIndeterminate="True"
                     HorizontalAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="6"
                  Margin="32,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding State, Converter={StaticResource StateEquals}, ConverterParameter='Empty'}">
        <TextBlock Classes="grid-title"
                   Text="{Binding EmptyTitle}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />
        <TextBlock Classes="grid-body"
                   Text="{Binding EmptyHint}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="8"
                  Margin="32,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  IsVisible="{Binding State, Converter={StaticResource StateEquals}, ConverterParameter='Error'}">
        <TextBlock Classes="grid-body"
                   Text="{Binding ErrorMessage}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button Content="{l:Tr Key=Common_Retry}"
                Command="{Binding ReloadCommand}"
                HorizontalAlignment="Center" />
      </StackPanel>

      <!-- Deferred delete: the row is gone, the delete is not, until the window closes -->
      <Border Margin="24,0,24,16"
              VerticalAlignment="Bottom"
              Background="{DynamicResource GridCellBrush}"
              BorderBrush="{DynamicResource GridLineBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="12,8"
              IsVisible="{Binding HasPendingDelete}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0"
                     Text="{Binding PendingDeleteText}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="{l:Tr Key=Common_Undo}"
                  Height="28"
                  Padding="12,4"
                  Command="{Binding UndoDeleteCommand}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="3"
            BorderBrush="{DynamicResource GridLineBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="24,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0"
                   Text="{Binding FooterText}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource GridMutedBrush}"
                   IsVisible="{Binding ShowFooterText}" />
        <TextBlock Grid.Column="0"
                   Text="{Binding CopyNotice}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource HistoryCopyNoticeBrush}"
                   IsVisible="{Binding IsShowingCopyNotice}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="{l:Tr Key=Selection_Select}"
                  Height="28"
                  Padding="12,4"
                  Command="{Binding ToggleSelectionCommand}"
                  IsVisible="{Binding ShowSelectButton}" />
          <Button Content="{l:Tr Key=Common_Cancel}"
                  Height="28"
                  Padding="12,4"
                  Command="{Binding ToggleSelectionCommand}"
                  IsVisible="{Binding IsSelecting}" />
          <Button Content="{l:Tr Key=Selection_Copy}"
                  Height="28"
                  Padding="12,4"
                  IsEnabled="{Binding CanCopySelection}"
                  Command="{Binding CopySelectedCommand}"
                  IsVisible="{Binding IsSelecting}" />
          <Button x:Name="ClearAllButton"
                  Background="Transparent"
                  BorderThickness="0"
                  Width="32"
                  Height="28"
                  Padding="0"
                  ToolTip.Tip="{l:Tr Key=Panel_ClearAll}"
                  IsEnabled="{Binding HasItems}"
                  Command="{Binding RequestClearCommand}"
                  IsVisible="{Binding ShowSelectButton}">
            <controls:AppIcon Kind="Delete" Width="16" Height="16" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- In-window confirmation panel (over the content, Esc cancels) -->
    <Grid Grid.Row="0"
          Grid.RowSpan="4"
          IsVisible="{Binding IsConfirmingClear}">
      <Border Background="#80000000" />
      <Border Background="{DynamicResource GridCellBrush}"
              BorderBrush="{DynamicResource GridLineBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="16"
              Width="300"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{l:Tr Key=Panel_ClearConfirm}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="{l:RtlAlign Desired=Right}">
            <Button x:Name="ConfirmClearButton"
                    Content="{l:Tr Key=Panel_ClearYes}"
                    Height="28"
                    Padding="12,4"
                    Command="{Binding ConfirmClearCommand}" />
            <Button Content="{l:Tr Key=Common_Cancel}"
                    Height="28"
                    Padding="12,4"
                    Command="{Binding CancelClearCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
