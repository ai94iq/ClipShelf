<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClipShelf.Desktop.Controls"
             xmlns:l="using:ClipShelf.Desktop.Common"
             xmlns:common="using:ClipShelf.Desktop.Common"
             xmlns:vm="using:ClipShelf.Presentation.Features.ClipboardPanel"
             x:Class="ClipShelf.Desktop.Views.HistoryPage"
             x:DataType="vm:ClipboardPanelViewModel"
             x:CompileBindings="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="24,18,24,0">
      <TextBlock Text="{l:Tr Key=History_Title}" FontSize="24" FontWeight="600" />
      <TextBlock Text="{l:Tr Key=History_Description}"
                 FontSize="13"
                 Foreground="{DynamicResource TextMuted}" />
    </StackPanel>

    <!-- Search and the category filter -->
    <Grid Grid.Row="1" Margin="24,12,24,6" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="SearchBox"
               Height="36"
               CornerRadius="8"
               IsEnabled="{Binding CanSearch}"
               Watermark="{l:Tr Key=Panel_SearchPlaceholder}"
               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox x:Name="CategoryFilter"
                Grid.Column="1"
                MinWidth="180"
                MinHeight="36"
                AutomationProperties.Name="{l:Tr Key=History_Filter}"
                ItemsSource="{Binding CategoryFilterOptions}"
                SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                SelectionChanged="OnCategoryFilterChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>

    <!-- Grouped history (Pinned, then Recent) on a card surface, with its loading/empty/error overlay -->
    <Grid Grid.Row="2">
      <Border Margin="24,4,24,8"
              Background="{DynamicResource SurfaceCard}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="10"
              BoxShadow="0 4 16 -4 #1A1A2E"
              IsVisible="{Binding HasItems, Converter={StaticResource BoolVisible}}">
        <ScrollViewer VerticalScrollBarVisibility="Visible"
                      ScrollChanged="OnScrollChanged"
                      PointerPressed="OnGroupsPointerPressed"
                      PointerReleased="OnGroupsPointerReleased">
          <ItemsControl x:Name="GroupsList"
                        Margin="8,8,8,4"
                        ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Title}"
                             FontSize="13"
                             FontWeight="600"
                             Foreground="{DynamicResource TextSecondary}"
                             Margin="0,12,0,2" />
                  <ListBox ItemsSource="{Binding}"
                           ItemTemplate="{StaticResource ClipItemTemplate}"
                           SelectionMode="Single"
                           SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                           Background="Transparent"
                           BorderThickness="0"
                           ScrollViewer.VerticalScrollBarVisibility="Disabled"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,7" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="Background" Value="Transparent" />
                      </Style>
                      <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="Transparent" />
                      </Style>
                      <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                      </Style>
                    </ListBox.Styles>
                  </ListBox>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <controls:LoadStateOverlay State="{Binding State}"
                                 ErrorMessage="{Binding ErrorMessage}"
                                 EmptyTitle="{Binding EmptyTitle}"
                                 EmptyHint="{Binding EmptyHint}"
                                 RetryCommand="{Binding ReloadCommand}" />

      <!-- Deferred delete: the row is gone, the delete is not, until the window closes -->
      <Border Classes="undo-bar"
              Margin="24,0,24,16"
              VerticalAlignment="Bottom"
              IsVisible="{Binding HasPendingDelete, Converter={StaticResource BoolVisible}}">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="{Binding PendingDeleteText}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="{l:Tr Key=Common_Undo}"
                  MinWidth="0"
                  Height="28"
                  Padding="12,4"
                  FontSize="13"
                  Command="{Binding UndoDeleteCommand}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="3"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderSubtle}">
      <Border Margin="24,8">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Text="{Binding FooterText}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextSecondary}"
                     IsVisible="{Binding ShowFooterText, Converter={StaticResource BoolVisible}}" />
          <TextBlock Grid.Column="0"
                     Text="{Binding CopyNotice}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource SuccessBrush}"
                     IsVisible="{Binding IsShowingCopyNotice, Converter={StaticResource BoolVisible}}" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="{l:Tr Key=Selection_Select}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ToggleSelectionCommand}"
                    IsVisible="{Binding ShowSelectButton, Converter={StaticResource BoolVisible}}" />
            <Button Content="{l:Tr Key=Common_Cancel}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ToggleSelectionCommand}"
                    IsVisible="{Binding IsSelecting, Converter={StaticResource BoolVisible}}" />
            <Button Content="{l:Tr Key=Selection_Copy}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding CanCopySelection}"
                    Command="{Binding CopySelectedCommand}"
                    IsVisible="{Binding IsSelecting, Converter={StaticResource BoolVisible}}" />
            <Button x:Name="ClearAllButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="32"
                    Height="28"
                    Padding="0"
                    IsEnabled="{Binding HasItems}"
                    ToolTip.Tip="{l:Tr Key=Panel_ClearAll}"
                    AutomationProperties.Name="{l:Tr Key=Panel_ClearAll}"
                    Command="{Binding RequestClearCommand}"
                    IsVisible="{Binding ShowSelectButton, Converter={StaticResource BoolVisible}}">
              <controls:AppIcon Kind="Delete" Width="16" Height="16" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- In-window confirmation panel (over the content, Esc cancels) -->
    <Grid Grid.Row="0"
          Grid.RowSpan="4"
          IsVisible="{Binding IsConfirmingClear, Converter={StaticResource BoolVisible}}">
      <Border Background="#80000000" />
      <Border Background="{DynamicResource SurfaceCard}"
              BorderBrush="{DynamicResource BorderDefault}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16"
              Width="300"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{l:Tr Key=Panel_ClearConfirm}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ConfirmClearButton"
                    Content="{l:Tr Key=Panel_ClearYes}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ConfirmClearCommand}" />
            <Button Content="{l:Tr Key=Common_Cancel}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{Binding CancelClearCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>