<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClipShelf.Desktop.Views.PasswordDialog"
        Width="320"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GridPaperBrush}">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock x:Name="WarningText"
               TextWrapping="Wrap"
               IsVisible="False" />
    <TextBox x:Name="CurrentBox" PasswordChar="*" IsVisible="False" />
    <TextBox x:Name="NewBox" PasswordChar="*" IsVisible="False" />
    <TextBox x:Name="ConfirmBox" PasswordChar="*" IsVisible="False" />
    <TextBlock x:Name="ErrorText"
               TextWrapping="Wrap"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               IsVisible="False" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="PrimaryButton" Click="OnPrimaryClick" IsEnabled="False" />
      <Button x:Name="CancelButton" Click="OnCancelClick" />
    </StackPanel>
  </StackPanel>
</Window>
