<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.Desktop.Common"
        x:Class="ClipShelf.Desktop.Views.PasswordDialog"
        x:CompileBindings="False"
        Title="Password"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceBackground}">
  <Border Background="{DynamicResource SurfaceCard}"
          BorderBrush="{DynamicResource BorderSubtle}"
          BorderThickness="1"
          CornerRadius="10"
          BoxShadow="0 8 24 -8 #1A1A2E"
          Margin="16">
    <StackPanel Margin="24" Spacing="20">
      <StackPanel Spacing="8">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="600" />
      </StackPanel>

      <StackPanel Spacing="12">
        <TextBox x:Name="CurrentPasswordBox"
                 PasswordChar="*"
                 Watermark="{l:Tr Key=Password_Current}" />

        <TextBox x:Name="NewPasswordBox"
                 PasswordChar="*"
                 Watermark="{l:Tr Key=Password_New}" />

        <TextBox x:Name="ConfirmPasswordBox"
                 PasswordChar="*"
                 Watermark="{l:Tr Key=Password_Confirm}" />
      </StackPanel>

      <TextBlock x:Name="WarningText"
                 FontSize="12"
                 Foreground="{DynamicResource TextMuted}"
                 TextWrapping="Wrap"
                 IsVisible="False" />

      <TextBlock x:Name="ErrorText"
                 FontSize="12"
                 Foreground="{DynamicResource ErrorBrush}"
                 TextWrapping="Wrap"
                 IsVisible="False" />

      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button x:Name="CancelButton" Content="{l:Tr Key=Common_Cancel}" Width="120" Height="40"
                Click="OnCancelClick" />
        <Button x:Name="PrimaryButton" Width="120" Height="40"
                Click="OnPrimaryClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>