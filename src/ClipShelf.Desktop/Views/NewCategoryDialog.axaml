<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.Desktop.Common"
        x:Class="ClipShelf.Desktop.Views.NewCategoryDialog"
        Title="{l:Tr Key=Category_NewTitle}"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceBackground}">
  <Border Background="{DynamicResource SurfaceCard}"
          BorderBrush="{DynamicResource BorderSubtle}"
          BorderThickness="1"
          CornerRadius="10"
          BoxShadow="0 8 24 -8 #1A1A2E"
          Margin="16">
    <StackPanel Margin="24" Spacing="20">
      <TextBlock Text="{l:Tr Key=Category_NewTitle}" FontSize="20" FontWeight="600" />

      <TextBox x:Name="NameBox"
               Watermark="{l:Tr Key=Category_NewPlaceholder}"
               Margin="0,8,0,0" />

      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="{l:Tr Key=Common_Cancel}" Width="120" Height="40"
                Click="OnCancelClick" />
        <Button Content="{l:Tr Key=Category_Create}" Width="120" Height="40"
                Click="OnCreateClick" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>