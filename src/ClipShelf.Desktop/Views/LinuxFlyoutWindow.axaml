<!-- Linux twin of FlyoutWindow.axaml: identical view, Linux code-behind. Keep the
     two in step; the view models and FlyoutActions are shared. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.Desktop.Common"
        xmlns:common="using:ClipShelf.Desktop.Common"
        xmlns:controls="using:ClipShelf.Desktop.Controls"
        xmlns:vm="using:ClipShelf.Presentation.Features.ClipboardPanel"
        x:Class="ClipShelf.Desktop.Views.LinuxFlyoutWindow"
        x:DataType="vm:ClipboardPanelViewModel"
        x:CompileBindings="False"
        Title="ClipShelf"
        Width="380"
        Height="520"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource SurfaceBackground}">
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search: just the field, no background or icon -->
    <Grid Grid.Row="0" Margin="12,10,12,4">
      <TextBox x:Name="SearchBox"
               Height="34"
               IsEnabled="{Binding CanSearch}"
               Watermark="{l:Tr Key=Panel_SearchPlaceholder}"
               Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Background="Transparent"
               BorderThickness="0" />
    </Grid>

    <!-- History with its loading/empty/error overlay -->
    <Grid Grid.Row="1">
      <ListBox x:Name="ClipList"
               Padding="0"
               ItemsSource="{Binding Items}"
               ItemTemplate="{StaticResource ClipItemTemplate}"
               SelectionMode="Single"
               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               PointerReleased="OnClipListPointerReleased"
               PointerPressed="OnClipListPointerPressed">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
          </Style>
        </ListBox.Styles>
      </ListBox>

      <controls:LoadStateOverlay State="{Binding State}"
                                 ErrorMessage="{Binding ErrorMessage}"
                                 EmptyTitle="{Binding EmptyTitle}"
                                 EmptyHint="{Binding EmptyHint}"
                                 RetryCommand="{Binding ReloadCommand}" />

      <!-- Deferred delete: the row is gone, the delete is not, until the window closes -->
      <Border Classes="undo-bar"
              Margin="12,0,12,8"
              VerticalAlignment="Bottom"
              IsVisible="{Binding HasPendingDelete, Converter={StaticResource BoolVisible}}">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="{Binding PendingDeleteText}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="{l:Tr Key=Common_Undo}"
                  MinWidth="0"
                  Height="28"
                  Padding="12,4"
                  FontSize="13"
                  Command="{Binding UndoDeleteCommand}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Footer: icon-only actions with tooltips -->
    <Border Grid.Row="2"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderSubtle}">
      <Border Margin="12,4">
        <Grid ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0"
                  Background="Transparent"
                  BorderThickness="0"
                  Width="32"
                  Height="28"
                  Padding="0"
                  HorizontalAlignment="Left"
                  ToolTip.Tip="{l:Tr Key=Panel_OpenFullHistory}"
                  AutomationProperties.Name="{l:Tr Key=Panel_OpenFullHistory}"
                  Command="{Binding OpenHistoryCommand}">
            <controls:AppIcon Kind="Clipboard" Width="16" Height="16" />
          </Button>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Button Background="Transparent"
                    BorderThickness="0"
                    Width="32"
                    Height="28"
                    Padding="0"
                    ToolTip.Tip="{l:Tr Key=Selection_Select}"
                    AutomationProperties.Name="{l:Tr Key=Selection_Select}"
                    Command="{Binding ToggleSelectionCommand}"
                    IsVisible="{Binding ShowSelectButton, Converter={StaticResource BoolVisible}}">
              <controls:AppIcon Kind="Checkmark" Width="16" Height="16" />
            </Button>

            <Button Background="Transparent"
                    BorderThickness="0"
                    Width="32"
                    Height="28"
                    Padding="0"
                    ToolTip.Tip="{l:Tr Key=Common_Cancel}"
                    AutomationProperties.Name="{l:Tr Key=Common_Cancel}"
                    Command="{Binding ToggleSelectionCommand}"
                    IsVisible="{Binding IsSelecting, Converter={StaticResource BoolVisible}}">
              <controls:AppIcon Kind="Dismiss" Width="16" Height="16" />
            </Button>

            <Button Background="Transparent"
                    BorderThickness="0"
                    Width="32"
                    Height="28"
                    Padding="0"
                    IsEnabled="{Binding CanCopySelection}"
                    ToolTip.Tip="{l:Tr Key=Selection_Copy}"
                    AutomationProperties.Name="{l:Tr Key=Selection_Copy}"
                    Command="{Binding CopySelectedCommand}"
                    IsVisible="{Binding IsSelecting, Converter={StaticResource BoolVisible}}">
              <controls:AppIcon Kind="Copy" Width="16" Height="16" />
            </Button>

            <Button x:Name="ClearAllButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="32"
                    Height="28"
                    Padding="0"
                    IsEnabled="{Binding HasItems}"
                    ToolTip.Tip="{l:Tr Key=Panel_ClearAll}"
                    AutomationProperties.Name="{l:Tr Key=Panel_ClearAll}"
                    Command="{Binding RequestClearCommand}"
                    IsVisible="{Binding ShowSelectButton, Converter={StaticResource BoolVisible}}">
              <controls:AppIcon Kind="Delete" Width="16" Height="16" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

    <!-- In-window confirmation panel (over the content, Esc cancels) -->
    <Grid Grid.Row="0"
          Grid.RowSpan="3"
          IsVisible="{Binding IsConfirmingClear, Converter={StaticResource BoolVisible}}"
          Background="#80000000">
      <Border Background="{DynamicResource SurfaceCard}"
              BorderBrush="{DynamicResource BorderDefault}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16"
              Width="260"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{l:Tr Key=Panel_ClearConfirm}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="ConfirmClearButton"
                    Content="{l:Tr Key=Panel_ClearYes}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{Binding ConfirmClearCommand}" />
            <Button Content="{l:Tr Key=Common_Cancel}"
                    MinWidth="0"
                    Height="28"
                    Padding="12,4"
                    FontSize="13"
                    HorizontalContentAlignment="Center"
                    Command="{Binding CancelClearCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>