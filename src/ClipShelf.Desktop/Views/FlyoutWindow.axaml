<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.Desktop.Common"
        xmlns:vm="using:ClipShelf.Presentation.Features.ClipboardPanel"
        x:Class="ClipShelf.Desktop.Views.FlyoutWindow"
        x:DataType="vm:ClipboardPanelViewModel"
        Title="ClipShelf"
        Width="360"
        Height="480"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Background="{DynamicResource GridPaperBrush}">
  <Grid RowDefinitions="Auto,*,Auto">
    <TextBox x:Name="SearchBox"
             Grid.Row="0"
             Classes="flyout-search"
             Margin="12,10,12,6"
             Padding="10,0"
             Height="32"
             IsEnabled="{Binding CanSearch}"
             PlaceholderText="{l:Tr Key=Panel_SearchPlaceholder}"
             Text="{Binding SearchText, Mode=TwoWay}" />

    <ListBox x:Name="ClipList"
             Grid.Row="1"
             Classes="clip-grid"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
             SelectionMode="Single"
             ItemTemplate="{StaticResource ClipCellTemplate}"
             PointerReleased="OnClipListPointerReleased"
             PointerPressed="OnClipListPointerPressed">
    </ListBox>

    <Border Grid.Row="2"
            BorderBrush="{DynamicResource GridLineBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock Margin="12,6"
                 Classes="grid-label"
                 Text="{Binding FooterText}" />
    </Border>

    <!-- Load states sit over the list: the quiet refresh never flashes them over content,
         because Error only sticks before the first load and Empty means zero rows. -->
    <StackPanel Grid.Row="1"
                Spacing="8"
                Margin="32,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding State, Converter={StaticResource StateEquals}, ConverterParameter='Idle,Loading'}">
      <ProgressBar Width="120"
                   IsIndeterminate="True"
                   HorizontalAlignment="Center" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Spacing="6"
                Margin="32,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding State, Converter={StaticResource StateEquals}, ConverterParameter='Empty'}">
      <TextBlock Classes="grid-title"
                 Text="{Binding EmptyTitle}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center" />
      <TextBlock Classes="grid-body"
                 Text="{Binding EmptyHint}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Spacing="8"
                Margin="32,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="{Binding State, Converter={StaticResource StateEquals}, ConverterParameter='Error'}">
      <TextBlock Classes="grid-body"
                 Text="{Binding ErrorMessage}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Content="{l:Tr Key=Common_Retry}"
              Command="{Binding ReloadCommand}"
              HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
