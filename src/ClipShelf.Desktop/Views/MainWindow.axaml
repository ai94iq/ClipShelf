<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:ClipShelf.Desktop.Controls"
        xmlns:l="using:ClipShelf.Desktop.Common"
        x:Class="ClipShelf.Desktop.Views.MainWindow"
        Title="ClipShelf"
        Width="980"
        Height="640"
        Background="{DynamicResource SurfaceBackground}">
  <Grid ColumnDefinitions="72,*">
    <!-- Sidebar -->
    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBackground}"
            BorderBrush="{DynamicResource SidebarBorder}"
            BorderThickness="0,0,1,0">
      <StackPanel Margin="0,20,0,0" Spacing="4">
        <!-- Logo/Brand -->
        <TextBlock Text="CS"
                   FontSize="24" FontWeight="600"
                   Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,24" />

        <!-- Navigation -->
        <Button x:Name="HistoryButton"
                Classes="nav"
                Click="OnHistoryClick"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="16,12"
                HorizontalContentAlignment="Left"
                Margin="8,0"
                ToolTip.Tip="{l:Tr Key=History_Title}"
                AutomationProperties.Name="{l:Tr Key=History_Title}">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
            <controls:AppIcon Kind="Clipboard" Width="20" Height="20" />
            <TextBlock Text="{l:Tr Key=History_Title}"
                       FontSize="14"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <Button x:Name="SettingsButton"
                Classes="nav"
                Click="OnSettingsClick"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                Padding="16,12"
                HorizontalContentAlignment="Left"
                Margin="8,0"
                ToolTip.Tip="{l:Tr Key=Nav_Settings}"
                AutomationProperties.Name="{l:Tr Key=Nav_Settings}">
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
            <controls:AppIcon Kind="Settings" Width="20" Height="20" />
            <TextBlock Text="{l:Tr Key=Nav_Settings}"
                       FontSize="14"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Main content area -->
    <Grid Grid.Column="1">
      <Border Background="{DynamicResource SurfaceBackground}" />
      <ContentControl x:Name="ContentArea" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" />
    </Grid>
  </Grid>
</Window>