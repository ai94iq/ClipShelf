<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.Desktop.Localization"
        x:Class="ClipShelf.Desktop.Shell.WelcomeWindow"
        Title="{l:Tr Key=App_Name}"
        Icon="/Assets/app.ico"
        Width="460" Height="320" CanResize="False"
        WindowStartupLocation="CenterScreen">
  <!-- Shown once, on the first run: the hotkey, and that the app lives in the tray. -->
  <StackPanel Margin="28" Spacing="14" VerticalAlignment="Center">
    <TextBlock Text="{l:Tr Key=App_Welcome}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="HotkeyText" TextWrapping="Wrap" />
    <TextBlock x:Name="TrayText" TextWrapping="Wrap"
               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
    <Button x:Name="OkButton" Classes="accent" Content="{l:Tr Key=Welcome_Ok}"
            HorizontalAlignment="Right" Margin="0,8,0,0" />
  </StackPanel>
</Window>
