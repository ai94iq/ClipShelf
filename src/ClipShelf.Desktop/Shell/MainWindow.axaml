<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:ClipShelf.Desktop.Localization"
        xmlns:controls="using:ClipShelf.Desktop.Controls"
        x:Class="ClipShelf.Desktop.Shell.MainWindow"
        Title="{l:Tr Key=App_Name}"
        Icon="/Assets/app.ico"
        Width="940" Height="660" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- Rail item: icon only, a hover wash, the accent tint when selected. -->
    <Style Selector="RadioButton.rail">
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.rail:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}" />
    </Style>
    <Style Selector="RadioButton.rail:checked">
      <Setter Property="Background" Value="{DynamicResource ClipShelfAccentSubtleBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
    </Style>
    <Style Selector="RadioButton.rail controls|AppIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
  </Window.Styles>

  <!-- The OS draws the title bar (app name, caption buttons) on every platform; Avalonia's
       drawn caption doubled the title and added a fullscreen button. -->
  <!-- The OS draws the title bar (app name, caption buttons) on every platform; Avalonia's
       drawn caption doubled the title and added a fullscreen button. -->
  <Grid ColumnDefinitions="48,*">
    <!-- Compact rail: History on top, Settings in the footer. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="4,8,4,8">
      <RadioButton x:Name="HistoryButton"
                   Classes="rail" GroupName="Nav"
                   ToolTip.Tip="{l:Tr Key=Nav_History}"
                   AutomationProperties.Name="{l:Tr Key=Nav_History}">
        <controls:AppIcon Kind="Document" />
      </RadioButton>
      <RadioButton x:Name="SettingsButton"
                   Grid.Row="2"
                   Classes="rail" GroupName="Nav"
                   ToolTip.Tip="{l:Tr Key=Nav_Settings}"
                   AutomationProperties.Name="{l:Tr Key=Nav_Settings}">
        <controls:AppIcon Kind="Settings" />
      </RadioButton>
    </Grid>

    <!-- Content column: the Settings search (Settings only) above the section. -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <TextBox x:Name="SearchBox"
               Width="360" Height="32" Margin="0,8,0,0"
               HorizontalAlignment="Center"
               PlaceholderText="{l:Tr Key=Settings_SearchPlaceholder}"
               AutomationProperties.Name="{l:Tr Key=Settings_SearchPlaceholder}"
               IsVisible="False" />
      <ContentControl x:Name="Section" Grid.Row="1" Margin="24,8,24,24" />
    </Grid>
  </Grid>
</Window>
