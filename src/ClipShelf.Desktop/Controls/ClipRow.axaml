<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:ClipShelf.Desktop.Localization"
             xmlns:controls="using:ClipShelf.Desktop.Controls"
             xmlns:vm="using:ClipShelf.Presentation.Features.ClipboardPanel"
             x:Class="ClipShelf.Desktop.Controls.ClipRow"
             x:DataType="vm:ClipItemViewModel">
  <!-- One clip in the flyout or History: thumbnail or preview, the source line, pin and delete. -->
  <UserControl.Styles>
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <!-- AppIcon styles as PathIcon (its style key), so selectors name PathIcon. Row actions are
         small accent glyphs (the owner's call), kept 12 px clear of the clip text. -->
    <Style Selector="Button.row PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundAccentBrush}" />
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="Auto,*,Auto">
    <!-- Select mode: the row is the hit target, the box only shows state. -->
    <CheckBox IsVisible="{Binding ShowSelection}" IsChecked="{Binding IsSelected}"
              IsHitTestVisible="False" Focusable="False" MinWidth="0" Margin="0,0,6,0"
              VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
      <Image IsVisible="{Binding HasImage}"
             Source="{Binding ThumbnailBytes, Converter={x:Static controls:BytesToBitmapConverter.Instance}}"
             MaxWidth="160" MaxHeight="72" Stretch="Uniform"
             HorizontalAlignment="Left" Margin="0,2" />
      <TextBlock Text="{Binding Preview}"
                 IsVisible="{Binding ShowPreview}"
                 FontSize="13" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding SourceText}"
                 FontSize="11" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" />
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Classes="row"
              Command="{Binding TogglePinCommand}"
              ToolTip.Tip="{l:Tr Key=Panel_PinToggle}"
              AutomationProperties.Name="{l:Tr Key=Panel_PinToggle}">
        <Panel>
          <controls:AppIcon Kind="Pin" IsVisible="{Binding !IsPinned}" />
          <controls:AppIcon Kind="PinOff" IsVisible="{Binding IsPinned}" />
        </Panel>
      </Button>
      <Button Classes="row category"
              Command="{Binding CategoryCommand}"
              ToolTip.Tip="{l:Tr Key=Panel_Category}"
              AutomationProperties.Name="{l:Tr Key=Panel_Category}">
        <controls:AppIcon Kind="Folder" />
      </Button>
      <Button Classes="row"
              Command="{Binding DeleteCommand}"
              ToolTip.Tip="{l:Tr Key=Panel_Delete}"
              AutomationProperties.Name="{l:Tr Key=Panel_Delete}">
        <controls:AppIcon Kind="Delete" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
