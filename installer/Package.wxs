<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- UpgradeCode is fixed forever. Never change it. -->
  <Package Name="!(loc.ProductName)"
           Manufacturer="!(loc.Manufacturer)"
           Version="$(var.Version)"
           Language="1033"
           UpgradeCode="92889A21-5376-451A-9E19-FCCC712A4539"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ClipShelf.exe" SourceFile="..\src\ClipShelf.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="ClipShelf.exe" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ClipShelf" />
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- Everything from the publish folder except the exe, which needs a known Id for the shortcut -->
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\ClipShelf.exe" />
      </Files>
      <Component Id="AppExe">
        <File Id="AppExeFile" Source="$(var.PublishDir)\ClipShelf.exe" KeyPath="yes" />
        <!-- Advertised shortcut in the exe's component: per-machine safe and ICE-clean. -->
        <Shortcut Id="AppShortcut"
                  Advertise="yes"
                  Directory="ProgramMenuFolder"
                  Name="!(loc.ProductName)"
                  Icon="ClipShelf.exe" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder" />
  </Fragment>
</Wix>
