<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- UpgradeCode is fixed forever. Never change it. -->
  <Package Name="!(loc.ProductName)"
           Manufacturer="!(loc.Manufacturer)"
           Version="$(var.Version)"
           Language="1033"
           UpgradeCode="92889A21-5376-451A-9E19-FCCC712A4539"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ClipShelf.exe" SourceFile="..\src\ClipShelf.App\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="ClipShelf.exe" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="Dialog.bmp" />

    <!-- Finish page: run ClipShelf when the checked option is left in place. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchProduct)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchClipShelf"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ClipShelf" />
    </StandardDirectory>

    <Feature Id="Main" Title="!(loc.ProductName)" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!-- Everything from the publish folder except the exe, which needs a known Id for the shortcut -->
      <Files Include="$(var.PublishDir)\**">
        <Exclude Files="$(var.PublishDir)\ClipShelf.exe" />
      </Files>
      <Component Id="AppExe">
        <File Id="AppExeFile" Source="$(var.PublishDir)\ClipShelf.exe" KeyPath="yes" />
        <!-- Advertised shortcuts in the exe's component: per-machine safe and ICE-clean. -->
        <Shortcut Id="AppShortcut"
                  Advertise="yes"
                  Directory="ProgramMenuFolder"
                  Name="!(loc.ProductName)"
                  Icon="ClipShelf.exe" />
        <Shortcut Id="DesktopShortcutShortcut"
                  Advertise="yes"
                  Directory="DesktopFolder"
                  Name="!(loc.ProductName)"
                  Icon="ClipShelf.exe" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder" />

    <StandardDirectory Id="DesktopFolder" />

    <!-- Type 2 custom action: launches the installed exe from the finish page. -->
    <CustomAction Id="LaunchClipShelf" FileRef="AppExeFile" ExeCommand="" Execute="immediate" Return="asyncNoWait" />
  </Fragment>
</Wix>
